# =============================================================
# OTRS / Znuny — environment variables template
# Copy this file to .env and fill in real values
# =============================================================

# --- Database ---
MYSQL_ROOT_PASSWORD=change_me_root_password
OTRS_DB_NAME=otrs
OTRS_DB_USER=otrs
OTRS_DB_PASSWORD=change_me_db_password

# --- Web port (host-side) ---
HTTP_PORT=8080

# --- OTRS system settings ---
ADMIN_EMAIL=admin@example.com
SYSTEM_EMAIL=support@example.com
ORGANIZATION=My Company

# --- Incoming mail (IMAP) ---
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=your-email@example.com
MAIL_IMAP_PASSWORD=your-app-password-here

# --- Outgoing mail (SMTP) ---
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=your-email@example.com
MAIL_SMTP_PASSWORD=your-app-password-here
